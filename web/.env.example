# Variables de entorno de la web (SOLO SERVIDOR).
# Copiar a .env.local (ignorado por git) y rellenar. NUNCA usar el prefijo
# NEXT_PUBLIC_ en ninguna de las dos: Next.js las enviaría al navegador.

SUPABASE_URL=https://qxwxftmlqimfausocwoi.supabase.co
# Clave secreta del proyecto (sb_secret_…). Crear una propia para la web en
# Supabase -> Project Settings -> API Keys -> Secret keys. No reutilizar la del
# pipeline: así se rotan por separado. No pegar el valor en el repo ni en el chat.
SUPABASE_SERVICE_KEY=
